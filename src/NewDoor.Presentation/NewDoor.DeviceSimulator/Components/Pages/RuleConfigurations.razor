@page "/configuration/ruleconfigurations"
@rendermode InteractiveServer
@using NewDoor.DeviceSimulator.Services
@using NewDoor.Platform.DTO.Features.RuleConfigurations.Models
@inject ApiClientService ApiClient

<PageTitle>Rule Configurations - Configuration</PageTitle>

<div class="configuration-container">
    <div class="page-header">
        <h2>Rule Configurations</h2>
        <button class="btn-refresh" @onclick="LoadRuleConfigurationsAsync">
            <i class="fas fa-sync-alt"></i> Refresh
        </button>
    </div>

    <div class="master-detail-layout">
        <div class="list-panel">
            <div class="list-header">
                <h3>Configurations (@ruleConfigurations.Count)</h3>
                <input type="text" placeholder="Search configurations..." @bind="searchText" @bind:event="oninput" class="search-input" />
            </div>

            @if (isLoading)
            {
                <div class="loading-state">Loading configurations...</div>
            }
            else if (!filteredConfigurations.Any())
            {
                <div class="empty-state">No configurations found.</div>
            }
            else
            {
                <div class="list-items">
                    @foreach (var config in filteredConfigurations)
                    {
                        <div class="list-item @(selectedConfig?.Id == config.Id ? "selected" : "")" @onclick="() => SelectConfiguration(config)">
                            <div class="item-header">
                                <span class="item-name">@config.ConfigKey</span>
                                <span class="badge badge-@(config.IsActive ? "active" : "inactive")">
                                    @(config.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            <div class="item-details">
                                <span class="item-label">Rule ID:</span>
                                <span class="item-value">@config.RuleId</span>
                            </div>
                            <div class="item-details">
                                <span class="item-label">Value:</span>
                                <span class="item-value">@config.ConfigValue @config.Unit</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="details-panel">
            @if (selectedConfig == null)
            {
                <div class="no-selection">
                    <i class="fas fa-sliders-h fa-3x"></i>
                    <p>Select a configuration to view details</p>
                </div>
            }
            else
            {
                <div class="details-content">
                    <div class="details-header">
                        <h3>@selectedConfig.ConfigKey</h3>
                        <span class="badge badge-@(selectedConfig.IsActive ? "active" : "inactive") large">
                            @(selectedConfig.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <div class="details-section">
                        <h4>Configuration Information</h4>
                        <div class="detail-grid">
                            <div class="detail-item">
                                <label>Configuration ID</label>
                                <span>@selectedConfig.Id</span>
                            </div>
                            <div class="detail-item">
                                <label>Rule ID</label>
                                <span>@selectedConfig.RuleId</span>
                            </div>
                            <div class="detail-item">
                                <label>Configuration Key</label>
                                <span>@selectedConfig.ConfigKey</span>
                            </div>
                            <div class="detail-item">
                                <label>Status</label>
                                <span>@(selectedConfig.IsActive ? "Active" : "Inactive")</span>
                            </div>
                        </div>
                    </div>

                    <div class="details-section">
                        <h4>Value & Unit</h4>
                        <div class="value-display">
                            <div class="value-item">
                                <label>Configuration Value</label>
                                <div class="value-box">@selectedConfig.ConfigValue</div>
                            </div>
                            <div class="value-item">
                                <label>Unit</label>
                                <div class="unit-box">@(string.IsNullOrEmpty(selectedConfig.Unit) ? "N/A" : selectedConfig.Unit)</div>
                            </div>
                        </div>
                    </div>

                    <div class="details-section">
                        <h4>Additional Information</h4>
                        <div class="info-cards">
                            <div class="info-card">
                                <i class="fas fa-link"></i>
                                <div class="info-content">
                                    <span class="info-label">Linked Rule</span>
                                    <span class="info-value">Rule #@selectedConfig.RuleId</span>
                                </div>
                            </div>
                            <div class="info-card">
                                <i class="fas fa-toggle-@(selectedConfig.IsActive ? "on" : "off")"></i>
                                <div class="info-content">
                                    <span class="info-label">Status</span>
                                    <span class="info-value">@(selectedConfig.IsActive ? "Active Configuration" : "Inactive Configuration")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<RuleConfigurationResponse> ruleConfigurations = new();
    private RuleConfigurationResponse? selectedConfig = null;
    private string searchText = "";
    private bool isLoading = true;

    private List<RuleConfigurationResponse> filteredConfigurations => ruleConfigurations
        .Where(c => string.IsNullOrEmpty(searchText) ||
                    c.ConfigKey.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    c.ConfigValue.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .OrderBy(c => c.RuleId)
        .ThenBy(c => c.ConfigKey)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadRuleConfigurationsAsync();
    }

    private async Task LoadRuleConfigurationsAsync()
    {
        isLoading = true;
        StateHasChanged();
        ruleConfigurations = await ApiClient.GetAllRuleConfigurationsAsync();
        isLoading = false;
        StateHasChanged();
    }

    private void SelectConfiguration(RuleConfigurationResponse config)
    {
        selectedConfig = config;
        StateHasChanged();
    }
}

