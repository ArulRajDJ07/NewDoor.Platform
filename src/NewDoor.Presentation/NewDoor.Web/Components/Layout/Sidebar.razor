@using Microsoft.AspNetCore.Components.Routing

<div class="sidebar">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">NewDoor</a>
        </div>
    </div>

    <div class="nav-menu">
        <NavLink class="nav-item px-3" href="/" Match="NavLinkMatch.All">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
            <i class="fas fa-home"></i> Dashboard
        </NavLink>

        <div class="nav-section-header">Monitoring</div>
        <NavLink class="nav-item px-3" href="/alarms">
            <i class="fas fa-bell"></i> Alarms
        </NavLink>
        <NavLink class="nav-item px-3" href="/incidents">
            <i class="fas fa-exclamation-triangle"></i> Incidents
        </NavLink>      
        <NavLink class="nav-item px-3" href="/events-history">
            <i class="fas fa-history"></i> Kafka Event Flow
        </NavLink>

        <div class="nav-section-header">Configuration</div>
        <NavLink class="nav-item px-3" href="/buildings">
            <i class="fas fa-building"></i> Buildings
        </NavLink>
        <NavLink class="nav-item px-3" href="/devices">
            <i class="fas fa-microchip"></i> Devices
        </NavLink>        
        <NavLink class="nav-item px-3" href="/rules">
            <i class="fas fa-gavel"></i> Rules
        </NavLink>
    </div>

    <div class="sidebar-footer">
        <div class="status-indicator"></div>
        <div class="version-info">
            <div class="version-text">Simulator v1.0.0</div>
            <div class="status-text">Ready</div>
        </div>
    </div>
</div>

<style>
    .sidebar {
        width: 250px;
        height: 100vh;
        background-image: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 70%);
        display: flex;
        flex-direction: column;
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
    }

    .top-row {
        background-color: rgba(0,0,0,0.4);
        border-bottom: 1px solid rgba(255,255,255,0.1);
        height: 3.5rem;
        display: flex;
        align-items: center;
    }

    .navbar-brand {
        font-size: 1.1rem;
        color: white !important;
    }

    .nav-menu {
        flex: 1;
        padding: 1rem 0;
        overflow-y: auto;
    }

    .nav-item {
        display: block;
        padding: 0.5rem 1rem;
        color: #d7d7d7;
        text-decoration: none;
        border-radius: 4px;
        margin: 0.2rem 0.5rem;
    }

    .nav-item:hover {
        background-color: rgba(255,255,255,0.1);
        color: white;
    }

    .nav-item.active {
        background-color: rgba(255,255,255,0.37);
        color: white;
    }

    .nav-item i {
        width: 2rem;
        font-size: 1.1rem;
        vertical-align: text-bottom;
        margin-right: 0.5rem;
    }

    .nav-section-header {
        padding: 1rem 1rem 0.5rem 1rem;
        color: #9ca3af;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 1rem;
    }

    .nav-section-header:first-of-type {
        margin-top: 0.5rem;
    }

    .sidebar-footer {
        padding: 1rem;
        border-top: 1px solid rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        gap: 10px;
        background-color: rgba(0,0,0,0.2);
    }

    .status-indicator {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .version-info {
        flex: 1;
    }

    .version-text {
        font-size: 0.7rem;
        font-weight: 600;
        color: #d7d7d7;
        line-height: 1.2;
    }

    .status-text {
        font-size: 0.65rem;
        color: #9ca3af;
        line-height: 1.2;
    }

    @@media (max-width: 640.98px) {
        .sidebar {
            width: 100%;
        }
    }
</style>
