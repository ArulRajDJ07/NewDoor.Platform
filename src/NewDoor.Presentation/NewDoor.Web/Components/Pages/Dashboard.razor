@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@using NewDoor.Web.Services
@using NewDoor.Web.Models
@inject DeviceService DeviceService
@inject SimulationEngineService SimulationEngine
@inject EventBufferService EventBuffer
@inject SignalRService SignalRService
@implements IAsyncDisposable

<PageTitle>Dashboard - Live Monitoring</PageTitle>

<div class="dashboard-container">
    <HeaderBar />

    <div class="main-content">
        <div class="metrics-row">
            <MetricsPanel />
        </div>

        <!-- Live Monitoring Section -->
        <div class="live-monitoring-section">
            <div class="section-header">
                <div class="header-left">
                    <h3> LIVE MONITORING</h3>
                    <span class="connection-badge @GetConnectionClass()">
                        @GetConnectionText()
                    </span>
                </div>
                <div class="header-right">
                    <div class="live-stats">
                        <span class="stat-item">
                            <i class="fas fa-bell"></i> Alarms: <strong>@liveAlarms.Count</strong>
                        </span>
                        <span class="stat-item">
                            <i class="fas fa-fire"></i> Incidents: <strong>@liveIncidents.Count</strong>
                        </span>
                    </div>
                </div>
            </div>

            <div class="live-updates-grid">
                <!-- Recent Alarms Column -->
                <div class="live-column">
                    <div class="column-header alarm-header">
                        <i class="fas fa-bell"></i> Alarms
                    </div>
                    <div class="column-content">
                        @if (!liveAlarms.Any())
                        {
                            <div class="empty-state">No alarms yet</div>
                        }
                        else
                        {
                            @foreach (var alarm in liveAlarms.Take(5))
                            {
                                <div class="live-item @(alarm.IsNew ? "new-item" : "")">
                                    <div class="item-header">
                                        <span class="severity-badge @GetSeverityClass(alarm.Alert.Severity)">
                                            @alarm.Alert.Severity
                                        </span>
                                        <span class="timestamp">@GetRelativeTime(alarm.ReceivedAt)</span>
                                    </div>
                                    <div class="item-body">
                                        <div class="item-title">@alarm.Alert.AlertId</div>
                                        <div class="item-message">@alarm.Alert.Message</div>
                                        <div class="item-location">
                                            📍 @alarm.Alert.BuildingCode - @alarm.Alert.Location
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Recent Incidents Column -->
                <div class="live-column">
                    <div class="column-header incident-header">
                        <i class="fas fa-fire"></i> Incidents
                    </div>
                    <div class="column-content">
                        @if (!liveIncidents.Any())
                        {
                            <div class="empty-state">No incidents yet</div>
                        }
                        else
                        {
                            @foreach (var incident in liveIncidents.Take(5))
                            {
                                <div class="live-item @(incident.IsNew ? "new-item" : "")">
                                    <div class="item-header">
                                        <span class="severity-badge @GetSeverityClass(incident.Alert.Severity)">
                                            @incident.Alert.Severity
                                        </span>
                                        <span class="timestamp">@GetRelativeTime(incident.ReceivedAt)</span>
                                    </div>
                                    <div class="item-body">
                                        <div class="item-title">@incident.Alert.AlertId</div>
                                        <div class="item-message">@incident.Alert.Message</div>
                                        <div class="item-location">
                                            📍 @incident.Alert.BuildingCode - @incident.Alert.Location
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                            </div>
                        </div>

                        <div class="stream-row">
                            <EventConsole />
                        </div>
                    </div>
                </div>

                @code {
                    private List<IncidentNotification> liveIncidents = new();
                    private List<AlarmNotification> liveAlarms = new();
                    private ConnectionState connectionState = ConnectionState.Disconnected;

                    protected override async Task OnInitializedAsync()
                    {
                        await DeviceService.LoadDataAsync();

                        // Subscribe to SignalR events
                        SignalRService.OnIncidentReceived += HandleIncidentReceived;
                        SignalRService.OnAlarmReceived += HandleAlarmReceived;
                        SignalRService.OnConnectionStateChanged += HandleConnectionStateChanged;

        // Start SignalR connection
        if (!SignalRService.IsConnected)
        {
            await SignalRService.StartAsync();
        }
    }

    private void HandleIncidentReceived(object? sender, IncidentNotification notification)
    {
        liveIncidents.Insert(0, notification);
        if (liveIncidents.Count > 10)
            liveIncidents = liveIncidents.Take(10).ToList();

        InvokeAsync(StateHasChanged);

        // Mark as not new after 5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            notification.IsNew = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void HandleAlarmReceived(object? sender, AlarmNotification notification)
    {
        liveAlarms.Insert(0, notification);
        if (liveAlarms.Count > 10)
            liveAlarms = liveAlarms.Take(10).ToList();

        InvokeAsync(StateHasChanged);

        // Mark as not new after 5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            notification.IsNew = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void HandleConnectionStateChanged(object? sender, ConnectionStateChangedEventArgs e)
    {
        connectionState = e.State;
        InvokeAsync(StateHasChanged);
    }

    private string GetConnectionClass()
    {
        return connectionState switch
        {
            ConnectionState.Connected => "connected",
            ConnectionState.Connecting => "connecting",
            ConnectionState.Reconnecting => "reconnecting",
            ConnectionState.Failed => "failed",
            _ => "disconnected"
        };
    }

    private string GetConnectionText()
    {
        return connectionState switch
        {
            ConnectionState.Connected => "● LIVE",
            ConnectionState.Connecting => "○ Connecting...",
            ConnectionState.Reconnecting => "○ Reconnecting...",
            ConnectionState.Failed => "× Failed",
            _ => "○ Disconnected"
        };
    }

    private string GetSeverityClass(string severity)
    {
        return severity?.ToLower() switch
        {
            "critical" => "severity-critical",
            "high" => "severity-high",
            "medium" => "severity-medium",
            "low" => "severity-low",
            _ => "severity-info"
        };
    }

    private string GetRelativeTime(DateTime timestamp)
    {
        var diff = DateTime.UtcNow - timestamp;
        if (diff.TotalSeconds < 60)
            return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}h ago";
        return timestamp.ToString("MMM dd HH:mm");
    }

    public async ValueTask DisposeAsync()
    {
        SignalRService.OnIncidentReceived -= HandleIncidentReceived;
        SignalRService.OnAlarmReceived -= HandleAlarmReceived;
        SignalRService.OnConnectionStateChanged -= HandleConnectionStateChanged;
    }
}

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #f5f5f5;
        color: #333333;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .main-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow: hidden;
        padding: 10px 15px;
        gap: 10px;
    }

    /* Row 1: Metrics Cards */
    .metrics-row {
        flex-shrink: 0;
    }

    /* Live Monitoring Section */
    .live-monitoring-section {
        flex: 0 0 450px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background: #f5f5f5;
        color: #1f2937;
        border-bottom: 1px solid #e0e0e0;
    }

    .header-left h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .connection-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        margin-left: 12px;
        background: rgba(255, 255, 255, 0.2);
    }

    .connection-badge.connected {
        background: #10b981;
        animation: pulse 2s infinite;
    }

    .connection-badge.connecting,
    .connection-badge.reconnecting {
        background: #f59e0b;
    }

    .connection-badge.failed,
    .connection-badge.disconnected {
        background: #ef4444;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .live-stats {
        display: flex;
        gap: 20px;
        font-size: 13px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .stat-item strong {
        font-size: 16px;
        font-weight: 700;
    }

    .live-updates-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: #e5e7eb;
        flex: 1;
        overflow: hidden;
    }

    .live-column {
        background: white;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .column-header {
        padding: 12px 15px;
        font-weight: 700;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .incident-header {
        background: #6b7280;
        color: white;
    }

    .alarm-header {
        background: #9ca3af;
        color: white;
    }

    .audit-header {
        background: #d1d5db;
        color: #4b5563;
    }

    .column-content {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #9ca3af;
        font-size: 13px;
    }

    .live-item {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 8px;
        transition: all 0.3s ease;
    }

    .live-item.new-item {
        background: #fef3c7;
        border-color: #fbbf24;
        box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.1);
        animation: fadeIn 0.5s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .severity-badge,
    .result-badge {
        font-size: 9px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 10px;
        text-transform: uppercase;
    }

    .severity-critical {
        background: #dc2626;
        color: white;
    }

    .severity-high {
        background: #f59e0b;
        color: white;
    }

    .severity-medium {
        background: #3b82f6;
        color: white;
    }

    .severity-low {
        background: #10b981;
        color: white;
    }

    .severity-info {
        background: #6b7280;
        color: white;
    }

    .result-success {
        background: #10b981;
        color: white;
    }

    .result-failed {
        background: #ef4444;
        color: white;
    }

    .result-info {
        background: #3b82f6;
        color: white;
    }

    .timestamp {
        font-size: 10px;
        color: #6b7280;
    }

    .item-body {
        font-size: 12px;
    }

    .item-title {
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 3px;
    }

    .item-message {
        color: #4b5563;
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .item-location {
        color: #6b7280;
        font-size: 11px;
    }

    /* Row 2: Devices + Simulator Controls - Fixed Height */
    .controls-row {
        display: flex;
        gap: 10px;
        flex: 0 0 400px;
        min-height: 400px;
        max-height: 400px;
    }

    .devices-section {
        flex: 0 0 340px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .simulator-section {
        flex: 1;
        overflow-y: auto;
    }

    /* Row 3: Live Event Stream - Takes Remaining Space */
    .stream-row {
        flex: 1;
        min-height: 300px;
        overflow: hidden;
    }
</style>
